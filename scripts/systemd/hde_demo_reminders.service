[Unit]
Description=Human Design Engine demo reminder sender
After=network.target hde-payment.service hde-reports.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/work/hd-platform
Environment=PYTHONPATH=/home/ubuntu/work/hd-platform:/home/ubuntu/work/hd-platform/scripts
Environment=HDE_DEMO_REMINDER_DRY_RUN=0
Environment=HDE_DEMO_UPGRADE_URL=https://humandesignengine.com/deconditioning/
Environment=HDE_DEMO_REMINDER_STATE_FILE=/home/ubuntu/work/hd-platform/.runtime/demo_reminders_sent.json
EnvironmentFile=/home/ubuntu/work/hd-platform/.env
ExecStart=/home/ubuntu/work/hd-platform/.venv/bin/python3 scripts/hde_demo_reminders.py
