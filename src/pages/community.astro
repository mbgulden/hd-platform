---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const loopStages = [
  {
    title: '1. Practice out loud',
    body: 'Members begin with a small daily body-led experiment: one authority check, one nervous-system reset, and one visible “here is what I noticed” reflection.',
    metric: 'Activation: first shared practice within 24 hours'
  },
  {
    title: '2. Invite one real relationship',
    body: 'Each report and Sanctuary flow points to one safe person who can practice with them: partner, friend, collaborator, or family member.',
    metric: 'Referral: one relationship invite generated per active member'
  },
  {
    title: '3. Map the relationship field',
    body: 'The shared chart view turns two designs into practical prompts: where to give space, where to wait, where to ask, and where the nervous system needs repair.',
    metric: 'Connection: relationship chart opened or requested'
  },
  {
    title: '4. Return tomorrow together',
    body: 'Community prompts convert insight into a recurring loop: compare what happened, name the next tiny experiment, and keep becoming in public without performance pressure.',
    metric: 'Retention: weekly shared check-in completed'
  }
];

const invitePrompts = [
  'What is one decision you want to make from your Authority this week — and who needs to be informed, invited, or given space?',
  'Where did your body say yes before your mind had a clean explanation?',
  'Which relationship gets easier when both charts are treated as nervous-system instructions instead of personality labels?',
  'What practice is small enough to repeat tomorrow even if life gets loud?'
];
---

<Layout
  title="Human Design Community Loop | Practice, Relationships, and Referrals"
  description="A retention and invitation funnel for Human Design Engine: daily shared practice, relationship charts, referrals, and community prompts."
>
  <Nav />

  <main class="community-page">
    <section class="hero">
      <span class="badge">Bring others to become with you</span>
      <h1>Human Design becomes sticky when it becomes a shared practice.</h1>
      <p class="subtitle">
        Reports are maps. The community loop turns the map into daily embodied action,
        relationship momentum, and a reason to return tomorrow with someone you trust.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/free-human-design-reading-generator/">Start with a free reading</a>
        <a class="btn btn-secondary" href="/buy-report/?report=relationship">Invite a relationship</a>
      </div>
    </section>

    <section class="section-container">
      <div class="section-header">
        <span class="eyebrow">Retention architecture</span>
        <h2>The loop</h2>
        <p>Each stage is deliberately small: one practice, one invite, one relationship lens, one return ritual.</p>
      </div>
      <div class="loop-grid">
        {loopStages.map((stage) => (
          <article class="loop-card">
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
            <p class="metric">{stage.metric}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="relationship-panel">
      <div>
        <span class="eyebrow">Relationship charts</span>
        <h2>Make Human Design relational, not solitary.</h2>
        <p>
          The invitation funnel starts after someone receives useful self-knowledge.
          The next product moment asks: “Who would understand you better if they had a map too?”
        </p>
      </div>
      <ul>
        <li>Partner and family chart prompts for decision-making, conflict repair, and energy hygiene.</li>
        <li>Friend/referral language that emphasizes shared practice instead of “send this link.”</li>
        <li>Sanctuary prompts that turn relationship insights into daily embodied experiments.</li>
      </ul>
    </section>

    <section class="section-container prompts-section">
      <div class="section-header">
        <span class="eyebrow">Community prompts</span>
        <h2>Prompts worth returning for</h2>
      </div>
      <div class="prompt-list">
        {invitePrompts.map((prompt) => (
          <blockquote>{prompt}</blockquote>
        ))}
      </div>
    </section>

    <section class="cta-card">
      <h2>Next implementation hooks</h2>
      <p>
        Ship the page now as the public product surface, then wire referral-code creation,
        relationship-chart invite tracking, and Sanctuary check-in events behind the funnel.
      </p>
      <a class="btn btn-primary" href="/deconditioning/">Continue into Somatic Sanctuary</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .community-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 88px 24px 72px;
  }
  .hero {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 84px;
  }
  .badge,
  .eyebrow {
    display: inline-block;
    padding: 6px 14px;
    background: var(--sage-glow);
    color: var(--sage-deep);
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 20px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  h1,
  h2,
  h3 {
    font-family: 'Playfair Display', serif;
    color: var(--sage-deep);
    line-height: 1.15;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    margin-bottom: 24px;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin-bottom: 16px;
  }
  h3 {
    font-size: 1.45rem;
    margin-bottom: 14px;
  }
  .subtitle,
  .section-header p,
  .relationship-panel p,
  .cta-card p {
    color: var(--text-secondary);
    font-size: 1.12rem;
  }
  .subtitle {
    max-width: 720px;
    margin: 0 auto 34px;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: var(--transition);
  }
  .btn-primary {
    background: var(--sage-deep);
    color: var(--cream-bg);
  }
  .btn-secondary {
    border: 1.5px solid var(--sage-light);
    color: var(--sage-deep);
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .section-container {
    margin-bottom: 78px;
  }
  .section-header {
    max-width: 760px;
    margin-bottom: 34px;
  }
  .loop-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .loop-card,
  .relationship-panel,
  .cta-card,
  blockquote {
    background: var(--cream-light);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .loop-card {
    padding: 26px;
  }
  .loop-card p {
    color: var(--text-secondary);
  }
  .metric {
    margin-top: 18px;
    color: var(--sage-deep) !important;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .relationship-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    padding: 38px;
    margin-bottom: 78px;
  }
  .relationship-panel ul {
    display: grid;
    gap: 16px;
    color: var(--text-secondary);
    padding-left: 20px;
  }
  .prompt-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  blockquote {
    margin: 0;
    padding: 24px;
    color: var(--sage-deep);
    font-size: 1.08rem;
    font-style: italic;
  }
  .cta-card {
    text-align: center;
    padding: 44px;
  }
  .cta-card p {
    max-width: 720px;
    margin: 0 auto 28px;
  }
  @media (max-width: 900px) {
    .loop-grid,
    .relationship-panel,
    .prompt-list {
      grid-template-columns: 1fr;
    }
    .community-page {
      padding-top: 56px;
    }
  }
</style>
