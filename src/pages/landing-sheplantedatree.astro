---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import emdash from '../content/emdash.json';

const { title, subtitle, description, readings } = emdash.shePlantedATreePage;
---

<Layout title="She Planted A Tree — Somatic Human Design Readings & Coaching | Becca Gulden" description={description}>
  <Nav />
  
  <main class="container">
    <div class="header">
      <span class="badge">Somatic Coaching &amp; Readings</span>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
      <p class="description">{description}</p>
    </div>

    <!-- 1-on-1 Coaching Readings Grid -->
    <div class="readings-grid">
      {readings.map(read => (
        <div class="reading-card" id={`reading-${read.id}`}>
          <div class="reading-icon" role="img" aria-label={read.name}>{read.icon}</div>
          <div class="reading-overline">Somatic Session</div>
          <h3 class="reading-name">{read.name}</h3>
          <div class="reading-price">${read.price}</div>
          <p class="reading-desc">{read.desc}</p>
          
          <ul class="reading-features">
            {read.features.map(feat => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z" fill="currentColor"></path>
                </svg>
                {feat}
              </li>
            ))}
          </ul>
          
          <button 
            class="checkout-btn" 
            data-pkg-name={read.name}
            data-pkg-desc={read.desc}
            data-price-cents={read.priceCents}
            data-is-sub={read.isSubscription ? "true" : "false"}
            data-id={read.id}
          >
            Book Session
          </button>
        </div>
      ))}
    </div>

    <!-- Coach reviews/somatic container details -->
    <section class="review-section">
      <h3>Reflections from the Vessel</h3>
      <div class="reviews-container">
        <div class="review-card">
          <p class="review-text">"Working with Becca allowed me to distinguish mental panic from physical response. I finally understand how to drop out of thinking and operate as a projector."</p>
          <div class="review-author">— Sarah M., Projector</div>
        </div>
        <div class="review-card">
          <p class="review-text">"The cycle alignment coaching changed how I structure my product sprints. Observing transit conditioning instead of fighting it completely removed my burnout."</p>
          <div class="review-author">— Marcus T., Generator</div>
        </div>
      </div>
    </section>

    <!-- Interactive Checkout Email Modal -->
    <div class="modal" id="emailModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-content">
        <h2 id="modalTitle">Secure Checkout</h2>
        <p>Please enter your email to proceed to Stripe secure payment.</p>
        <form id="checkoutForm">
          <div class="form-group">
            <label for="checkoutEmail">Email Address</label>
            <input type="email" id="checkoutEmail" required placeholder="you@example.com" />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" id="cancelModalBtn">Cancel</button>
            <button type="submit" class="btn-submit" id="submitModalBtn">Proceed to Stripe →</button>
          </div>
        </form>
        <p class="error-msg" id="modalError"></p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
  }
  .header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
  }
  .badge {
    display: inline-block;
    padding: 6px 14px;
    background: var(--sage-glow);
    color: var(--sage-deep);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 20px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.8rem;
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .subtitle {
    font-size: 1.25rem;
    color: var(--sage-mid);
    font-style: italic;
    margin-bottom: 20px;
  }
  .description {
    color: var(--text-secondary);
  }

  /* readings callout grid */
  .readings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 80px;
  }
  .reading-card {
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
    transition: var(--transition);
  }
  .reading-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(47, 54, 49, 0.05);
  }
  .reading-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }
  .reading-overline {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--sage-mid);
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  .reading-name {
    font-size: 1.2rem;
    color: var(--sage-deep);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .reading-price {
    font-size: 1.8rem;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .reading-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 24px;
    line-height: 1.5;
    min-height: 54px;
  }
  .reading-features {
    list-style: none;
    margin-bottom: 30px;
    flex: 1;
  }
  .reading-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.88rem;
    color: var(--text-primary);
  }
  .reading-features svg {
    width: 16px;
    height: 16px;
    color: var(--sage-mid);
    flex-shrink: 0;
  }
  .checkout-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--sage-deep);
    border: 1.5px solid var(--sage-light);
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition);
  }
  .checkout-btn:hover {
    background: var(--sage-deep);
    color: var(--cream-bg);
    border-color: var(--sage-deep);
  }

  /* reviews section */
  .review-section {
    background: var(--cream-light);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 60px 40px;
    text-align: center;
  }
  .review-section h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--sage-deep);
    margin-bottom: 40px;
  }
  .reviews-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    text-align: left;
  }
  .review-card {
    border-left: 3px solid var(--sage-light);
    padding-left: 20px;
  }
  .review-text {
    font-style: italic;
    color: var(--text-secondary);
    margin-bottom: 12px;
    font-size: 0.98rem;
  }
  .review-author {
    font-weight: 600;
    color: var(--sage-deep);
    font-size: 0.88rem;
  }

  /* Modal Styling */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(47, 54, 49, 0.4);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition);
  }
  .modal.active {
    opacity: 1;
    visibility: visible;
  }
  .modal-content {
    background: var(--white);
    padding: 40px;
    border-radius: var(--radius-lg);
    max-width: 440px;
    width: 100%;
    box-shadow: var(--shadow);
  }
  .modal-content h2 {
    font-family: 'Playfair Display', serif;
    color: var(--sage-deep);
    margin-bottom: 10px;
  }
  .modal-content p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }
  .form-group {
    margin-bottom: 24px;
  }
  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sage-deep);
    margin-bottom: 8px;
  }
  .form-group input {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-family: inherit;
    background: var(--cream-bg);
  }
  .form-group input:focus {
    outline: 2px solid var(--sage-mid);
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
  .btn-cancel {
    background: none;
    border: none;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-muted);
    padding: 10px 20px;
  }
  .btn-submit {
    background: var(--sage-deep);
    color: var(--cream-bg);
    border: none;
    border-radius: 30px;
    font-weight: 600;
    cursor: pointer;
    padding: 12px 24px;
    transition: var(--transition);
  }
  .btn-submit:hover {
    background: var(--sage-mid);
  }
  .error-msg {
    color: #cc3333;
    font-size: 0.85rem;
    margin-top: 16px;
    text-align: center;
    display: none;
  }
</style>

<script>
  let selectedPkg = { name: '', desc: '', priceCents: 0, isSub: false, id: '' };
  
  const modal = document.getElementById('emailModal');
  const cancelBtn = document.getElementById('cancelModalBtn');
  const form = document.getElementById('checkoutForm');
  const errorMsg = document.getElementById('modalError');
  const submitBtn = document.getElementById('submitModalBtn');

  document.querySelectorAll('.checkout-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedPkg = {
        name: btn.getAttribute('data-pkg-name') || '',
        desc: btn.getAttribute('data-pkg-desc') || '',
        priceCents: parseInt(btn.getAttribute('data-price-cents') || '0', 10),
        isSub: btn.getAttribute('data-is-sub') === 'true',
        id: btn.getAttribute('data-id') || ''
      };
      if (modal) modal.classList.add('active');
    });
  });

  if (cancelBtn && modal) {
    cancelBtn.addEventListener('click', () => {
      modal.classList.remove('active');
      if (errorMsg) errorMsg.style.display = 'none';
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Redirecting...';
      }
      if (errorMsg) errorMsg.style.display = 'none';

      const email = (document.getElementById('checkoutEmail') as HTMLInputElement).value.trim();

      try {
        const response = await fetch('/api/checkout/create-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            product_name: selectedPkg.name,
            product_description: selectedPkg.desc,
            price_cents: selectedPkg.priceCents,
            is_subscription: selectedPkg.isSub,
            metadata: {
              tier: 'premium', // Marks as premium user in database for 1-on-1 coaching
              product: selectedPkg.id
            }
          })
        });

        if (!response.ok) throw new Error('Checkout API failed');
        const data = await response.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error('No checkout URL returned from server.');
        }
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent = 'Failed to initiate checkout. Please try again.';
          errorMsg.style.display = 'block';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Proceed to Stripe →';
        }
      }
    });
  }
</script>
