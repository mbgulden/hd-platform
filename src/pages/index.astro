---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Human Design Engine — Verifiable calculations, premium reports, and deconditioning tools">
  <Nav />
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <h1>The <em>Calming Intelligence</em> of Human Design</h1>
      <p class="hero-subtitle">An open, peer-reviewed calculation engine, premium PDF reports, and somatic tools built to guide you back to your body signature.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#calculator">Calculate Free Chart</a>
        <a class="btn btn-secondary" href="/deconditioning">Explore Somatic Sanctuary</a>
      </div>
    </section>

    <!-- Featured Product: Somatic deconditioning -->
    <section class="featured-section">
      <div class="featured-container">
        <div class="featured-image-card">
          <div class="img-card-title">Somatic Sanctuary</div>
          <div class="img-card-desc">Sovereign Container &amp; De-programming Companion</div>
          <div class="img-card-quote">
            "Observe the mind, validate the centers, and return response to the physical vessel."
          </div>
        </div>
        
        <div class="featured-content">
          <span class="featured-badge">Featured Sanctuary</span>
          <h2>Dismantle mental conditioning with <em>somatic alignment</em></h2>
          <p class="featured-text">
            Our new flagship container is a private, low-stimulus space designed to return you to your authority. Step away from rigid concepts and learn to respond in real-time.
          </p>
          <ul class="featured-features">
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              6-Week Sovereign Coaching with Becca Gulden
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Private Telegram Coach Bot companion
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Custom daily somatic movements and vagal toning plans
            </li>
          </ul>
          <a class="btn btn-primary" href="/deconditioning">Learn More &amp; Register</a>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="section-container calculator-section" id="calculator">
      <div class="section-header">
        <h2>Your Bodygraph</h2>
        <p>Enter your birth data to calculate your active gates, defined centers, and basic somatic strategy.</p>
      </div>
      <div class="calc-wrapper">
        <!-- Human Design Engine Widget mounting point -->
        <hd-bodygraph data-interactive="true" data-theme="gold" data-api="" data-show-form="true"></hd-bodygraph>
      </div>
    </section>

    <!-- Reports Pricing Section -->
    <section class="section-container reports-section" id="reports">
      <div class="section-header">
        <h2>Premium Reports &amp; Blueprints</h2>
        <p>Purchase high-fidelity, comprehensive PDF reports computed directly using our verified ephemeris backend.</p>
      </div>
      <div class="pricing-grid">
        <!-- Natal Report -->
        <div class="price-card">
          <div class="card-title">Natal Report</div>
          <div class="card-price">
            <span class="currency">$</span>
            <span class="amount">19</span>
          </div>
          <p class="card-desc">Complete analysis of your Type, Authority, defined centers, profiles, and individual gate activations.</p>
          <ul class="price-features">
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              20+ page customized PDF
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Delivered instantly via email
            </li>
          </ul>
          <a class="price-btn price-btn-outline" href="/buy-report.html?report=natal">Order Report</a>
        </div>

        <!-- Bundle -->
        <div class="price-card featured-card">
          <div class="card-badge">Best Value</div>
          <div class="card-title">Complete Blueprint Bundle</div>
          <div class="card-price">
            <span class="currency">$</span>
            <span class="amount">59</span>
          </div>
          <p class="card-desc">The ultimate package: Includes your custom Natal report, transit forecasting, and relationship compatibility blueprint.</p>
          <ul class="price-features">
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Natal, Transit &amp; Relationship PDFs
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Saves $18 compared to separate orders
            </li>
          </ul>
          <a class="price-btn price-btn-filled" href="/buy-report.html?report=bundle">Order Bundle</a>
        </div>

        <!-- Transit Report -->
        <div class="price-card">
          <div class="card-title">Transit Forecast</div>
          <div class="card-price">
            <span class="currency">$</span>
            <span class="amount">29</span>
          </div>
          <p class="card-desc">Understand current planetary cycles, weather conditions, and how they define your daily energy centers over the next 12 months.</p>
          <ul class="price-features">
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              12-Month cycles forecast
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.629,14.566c0.125,0.125,0.291,0.188,0.456,0.188c0.164,0,0.329-0.062,0.456-0.188l8.219-8.221c0.252-0.252,0.252-0.659,0-0.911c-0.252-0.252-0.659-0.252-0.911,0l-7.764,7.763L4.152,9.267c-0.252-0.251-0.66-0.251-0.911,0c-0.252,0.252-0.252,0.66,0,0.911L7.629,14.566z"/></svg>
              Comprehensive daily activation mapping
            </li>
          </ul>
          <a class="price-btn price-btn-outline" href="/buy-report.html?report=transit">Order Forecast</a>
        </div>
      </div>
    </section>

    <!-- Developer API Section -->
    <section class="section-container api-section">
      <div class="api-card">
        <h3>Human Design Engine API</h3>
        <p>Are you building an application, software, or customized calculator? Integrate our verified, fast, and open-source backend API endpoints. Available now with fully documented REST endpoints.</p>
        <a class="btn btn-secondary" href="/docs">Explore Developer Portal</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---- Hero Section ---- */
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 24px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--sage-deep);
    line-height: 1.15;
    margin-bottom: 24px;
    max-width: 900px;
  }
  h1 em {
    font-weight: 400;
    font-style: italic;
    color: var(--sage-mid);
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin-bottom: 40px;
    font-weight: 400;
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 30px;
    text-decoration: none;
    transition: var(--transition);
    cursor: pointer;
    border: none;
  }
  .btn-primary {
    background-color: var(--sage-deep);
    color: var(--cream-bg);
  }
  .btn-primary:hover {
    background-color: var(--sage-mid);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--sage-deep);
    border: 1.5px solid var(--sage-light);
  }
  .btn-secondary:hover {
    background-color: var(--sage-glow);
    border-color: var(--sage-deep);
    transform: translateY(-1px);
  }

  /* ---- Featured Product: Somatic deconditioning ---- */
  .featured-section {
    background: var(--cream-light);
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
    padding: 90px 24px;
  }
  .featured-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .featured-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--sage-deep);
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .featured-content h2 em {
    font-weight: 400;
    font-style: italic;
    color: var(--sage-mid);
  }
  .featured-badge {
    display: inline-block;
    padding: 6px 14px;
    background: var(--sage-glow);
    color: var(--sage-deep);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 20px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .featured-text {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .featured-features {
    margin-bottom: 36px;
    list-style: none;
  }
  .featured-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .featured-features svg {
    width: 18px;
    height: 18px;
    fill: var(--sage-mid);
  }
  .featured-image-card {
    background: var(--cream-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    aspect-ratio: 1.15;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }
  .featured-image-card::after {
    content: '';
    position: absolute;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, var(--sage-glow) 0%, transparent 70%);
    top: -50px;
    right: -50px;
  }
  .img-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: var(--sage-deep);
    margin-bottom: 12px;
  }
  .img-card-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }
  .img-card-quote {
    font-style: italic;
    color: var(--taupe-muted);
    border-left: 2.5px solid var(--sage-light);
    padding-left: 16px;
    margin-top: auto;
    font-size: 0.9rem;
  }

  /* ---- Section Layouts ---- */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 90px 24px;
  }
  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .section-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .section-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ---- Calculator Section & Widget CSS Overrides ---- */
  .calculator-section {
    background: var(--cream-bg);
  }
  .calc-wrapper {
    max-width: 600px;
    margin: 0 auto;
  }
  
  /* Global Overrides for <hd-bodygraph> Widget to match Sage Green Theme */
  :global(.hde-card) {
    background-color: var(--white) !important;
    border: 1px solid var(--card-border) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow) !important;
    color: var(--text-primary) !important;
    padding: 32px !important;
  }
  :global(.hde-header h2) {
    font-family: 'Playfair Display', serif !important;
    color: var(--sage-deep) !important;
    font-weight: 700 !important;
  }
  :global(.hde-header p) {
    color: var(--text-secondary) !important;
  }
  :global(.hde-form-group label) {
    color: var(--sage-deep) !important;
    font-weight: 500 !important;
    font-size: 0.85rem !important;
    margin-bottom: 6px !important;
  }
  :global(.hde-form-group input) {
    background: var(--cream-bg) !important;
    border: 1px solid var(--card-border) !important;
    color: var(--text-primary) !important;
    border-radius: 8px !important;
    padding: 11px 14px !important;
    font-family: inherit !important;
    transition: var(--transition) !important;
  }
  :global(.hde-form-group input:focus) {
    border-color: var(--sage-mid) !important;
    outline: 2px solid var(--sage-glow) !important;
  }
  :global(.hde-btn) {
    background: var(--sage-deep) !important;
    color: var(--cream-bg) !important;
    border-radius: 30px !important;
    font-family: inherit !important;
    font-weight: 600 !important;
    padding: 12px 24px !important;
    transition: var(--transition) !important;
  }
  :global(.hde-btn:hover) {
    background: var(--sage-mid) !important;
    transform: translateY(-1px) !important;
  }
  :global(.hde-stat) {
    background: var(--cream-bg) !important;
    border: 1px solid var(--card-border) !important;
    border-radius: 8px !important;
    padding: 12px 16px !important;
  }
  :global(.hde-stat-label) {
    color: var(--text-muted) !important;
  }
  :global(.hde-stat-value) {
    color: var(--sage-deep) !important;
    font-weight: 600 !important;
  }
  :global(.hde-center-badge) {
    background: var(--sage-glow) !important;
    color: var(--sage-deep) !important;
    border: 1px solid var(--card-border) !important;
    font-size: 0.8rem !important;
    border-radius: 6px !important;
  }
  :global(.hde-signature) {
    background: var(--cream-light) !important;
    border: 1px solid var(--card-border) !important;
    border-radius: 8px !important;
  }
  :global(.hde-signature-label) {
    color: var(--sage-mid) !important;
  }
  :global(.hde-signature-value) {
    color: var(--sage-deep) !important;
  }
  :global(.hde-cta-link) {
    background: var(--sage-glow) !important;
    border: 1px solid var(--card-border) !important;
    color: var(--sage-deep) !important;
    border-radius: var(--radius) !important;
    font-family: inherit !important;
  }
  :global(.hde-cta-link:hover) {
    background: rgba(95, 114, 97, 0.2) !important;
    border-color: var(--sage-deep) !important;
  }

  /* ---- Reports Pricing Grid ---- */
  .reports-section {
    background: var(--cream-light);
    border-top: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
  }
  .price-card {
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    box-shadow: var(--shadow);
  }
  .price-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(47, 54, 49, 0.05);
  }
  .price-card.featured-card {
    border: 1.5px solid var(--sage-mid);
    position: relative;
  }
  .price-card.featured-card .card-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sage-deep);
    color: var(--cream-bg);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sage-deep);
    margin-bottom: 10px;
  }
  .card-price {
    display: flex;
    align-items: baseline;
    margin-bottom: 20px;
  }
  .card-price .currency {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--sage-deep);
  }
  .card-price .amount {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--sage-deep);
    font-family: 'Playfair Display', serif;
  }
  .card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
    flex: 1;
  }
  .price-features {
    list-style: none;
    margin-bottom: 32px;
    font-size: 0.9rem;
    color: var(--text-primary);
  }
  .price-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .price-features svg {
    width: 14px;
    height: 14px;
    fill: var(--sage-mid);
  }
  .price-btn {
    width: 100%;
    text-align: center;
    padding: 12px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: var(--transition);
    display: block;
    border: 1px solid var(--sage-deep);
  }
  .price-btn-outline {
    background: transparent;
    color: var(--sage-deep);
  }
  .price-btn-outline:hover {
    background: var(--sage-glow);
  }
  .price-btn-filled {
    background: var(--sage-deep);
    color: var(--cream-bg);
  }
  .price-btn-filled:hover {
    background: var(--sage-mid);
    border-color: var(--sage-mid);
  }

  /* ---- Developer API Section ---- */
  .api-section {
    background: var(--cream-bg);
    text-align: center;
  }
  .api-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 48px;
    box-shadow: var(--shadow);
  }
  .api-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .api-card p {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  /* Include Widget Javascript to mount the chart component */
  script {
    /* To handle the <hd-bodygraph> rendering script */
  }

  @media (max-width: 868px) {
    .featured-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .featured-content { order: 2; }
    .featured-image-card { order: 1; aspect-ratio: 1.3; }
