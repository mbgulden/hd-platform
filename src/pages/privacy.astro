---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Privacy Policy — Human Design Engine" description="Human Design Engine privacy policy.">
  <Nav />
  <main class="legal-page">
    <h1>Privacy Policy</h1>
    <p>Human Design Engine uses birth data only to calculate and deliver Human Design chart results and reports. We do not sell personal birth data.</p>
    <p>Payment processing is handled by third-party payment providers. Telegram onboarding data is used only to connect paid users to the correct guide experience.</p>
    <p>Contact team@humandesignengine.com for privacy questions or data removal requests.</p>
  </main>
  <Footer />
</Layout>
<style>.legal-page{max-width:760px;margin:0 auto;padding:96px 24px;color:#2F3631}.legal-page h1{font-family:'Playfair Display',Georgia,serif;font-size:3rem}.legal-page p{line-height:1.8;color:#5C625E}</style>
