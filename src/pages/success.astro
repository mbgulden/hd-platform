---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import emdash from '../content/emdash.json';

const calLink = emdash.global.coachingCalLink || 'becca-gulden/coaching';
---

<Layout title="Registration Successful | Human Design Engine">
  <Nav />
  
  <main class="container">
    <div class="success-card" data-cal-link={calLink}>
      <div class="icon-wrap">✨</div>
      <h1>Your Vessel is Registered</h1>
      <p class="subtitle">Observe the mind, validate the centers, and return response to the physical vessel.</p>
      
      <!-- Somatic Breathing Mandala -->
      <div class="breathing-container">
        <img src="/somatic_mandala.png" class="breathing-mandala" id="breathingMandala" alt="Somatic breathing mandala" />
        <p class="breathing-instruction" id="breathingText">Inhale...</p>
      </div>

      <div class="onboarding-action" id="onboardingAction">
        <p class="status-text">Activating your container... please do not close this window.</p>
        <div class="spinner"></div>
      </div>

      <!-- Cal.com Scheduling Widget (Conditional) -->
      <div id="calContainer" style="display: none; margin-top: 36px; border-top: 1px solid var(--card-border); padding-top: 36px; text-align: left;">
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.45rem; color: var(--sage-deep); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">📅 Book Your Coaching Integration</h2>
        <p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 24px; line-height: 1.5;">Welcome, Sovereign client. Please schedule your first 1-on-1 nervous system coaching session with Becca Gulden using the calendar below:</p>
        
        <!-- Cal element-embed start -->
        <div style="width:100%;height:650px;overflow:scroll;border: 1px solid var(--card-border);border-radius:12px;background-color: var(--white);" id="my-cal-inline"></div>
      </div>

      <!-- Fallback Email Form -->
      <div class="fallback-form" id="fallbackForm">
        <h3>Retrieve Onboarding Link</h3>
        <p>If your bot activation link didn't load automatically, enter your email below to retrieve it.</p>
        <form id="emailForm">
          <input type="email" id="emailInput" placeholder="you@email.com" required />
          <button type="submit">Get Link</button>
        </form>
        <p class="error-msg" id="onboardingError"></p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
    display: flex;
    justify-content: center;
  }
  .success-card {
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 60px 40px;
    max-width: 720px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .icon-wrap {
    font-size: 3rem;
    margin-bottom: 20px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    color: var(--sage-deep);
    font-size: 2.2rem;
    margin-bottom: 12px;
  }
  .subtitle {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 1.05rem;
    margin-bottom: 40px;
    line-height: 1.5;
  }

  /* Breathing Circle Animation */
  .breathing-container {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .breathing-mandala {
    width: 140px;
    height: 140px;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 4s cubic-bezier(0.4, 0, 0.2, 1), opacity 4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(0.8);
    opacity: 0.6;
    filter: drop-shadow(0 4px 12px var(--sage-glow));
  }
  .breathing-instruction {
    margin-top: 16px;
    font-weight: 500;
    color: var(--sage-mid);
    font-size: 0.95rem;
  }

  .onboarding-action {
    background: var(--cream-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .status-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    font-weight: 500;
  }
  .spinner {
    width: 24px;
    height: 24px;
    border: 2.5px solid var(--sage-glow);
    border-top-color: var(--sage-mid);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  .btn-launch {
    display: inline-block;
    padding: 14px 28px;
    background: var(--sage-deep);
    color: var(--cream-bg);
    text-decoration: none;
    font-weight: 600;
    border-radius: 30px;
    transition: var(--transition);
  }
  .btn-launch:hover {
    background: var(--sage-mid);
    transform: translateY(-1px);
  }

  .fallback-form {
    border-top: 1px solid var(--card-border);
    padding-top: 30px;
    text-align: left;
    display: none;
  }
  .fallback-form h3 {
    font-size: 1.05rem;
    color: var(--sage-deep);
    margin-bottom: 8px;
  }
  .fallback-form p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }
  .fallback-form form {
    display: flex;
    gap: 10px;
  }
  .fallback-form input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: var(--cream-bg);
    font-family: inherit;
    font-size: 0.9rem;
  }
  .fallback-form input:focus {
    outline: 2px solid var(--sage-mid);
  }
  .fallback-form button {
    padding: 10px 20px;
    background: var(--sage-deep);
    color: var(--cream-bg);
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .fallback-form button:hover {
    background: var(--sage-mid);
  }
  .error-msg {
    color: #cc3333;
    font-size: 0.85rem;
    margin-top: 10px;
    display: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  // Somatic Breathing Pacing Loop (4s inhale, 4s exhale)
  const mandala = document.getElementById('breathingMandala');
  const text = document.getElementById('breathingText');
  let inhale = true;

  if (mandala && text) {
    setInterval(() => {
      if (inhale) {
        mandala.style.transform = 'scale(1.15) rotate(15deg)';
        mandala.style.opacity = '1.0';
        text.textContent = 'Hold... Exhale...';
        inhale = false;
      } else {
        mandala.style.transform = 'scale(0.8) rotate(0deg)';
        mandala.style.opacity = '0.6';
        text.textContent = 'Inhale...';
        inhale = true;
      }
    }, 4000);
  }

  // Stripe Session Fetching and Redirect
  const onboardingContainer = document.getElementById('onboardingAction');
  const fallback = document.getElementById('fallbackForm');
  const errorMsg = document.getElementById('onboardingError');
  const emailForm = document.getElementById('emailForm');
  
  const card = document.querySelector('.success-card');
  const calLink = card ? (card.getAttribute('data-cal-link') || 'becca-gulden/coaching') : 'becca-gulden/coaching';

  const urlParams = new URLSearchParams(window.location.search);
  const sessionId = urlParams.get('session_id');

  const loadCalWidget = (calendarPath: string, clientName: string, clientEmail: string) => {
    const w = window as any;
    if (!w.Cal) {
      const s = document.createElement('script');
      s.type = 'text/javascript';
      s.innerHTML = `
        (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; C.Cal = C.Cal || function () { let a = C.Cal; if (!a.q) { a.q = []; } p(a, arguments); }; })(window, window.Cal, "init");
        Cal("init", {origin:"https://cal.com"});
      `;
      document.head.appendChild(s);
    }
    
    const interval = setInterval(() => {
      if (w.Cal) {
        clearInterval(interval);
        w.Cal("inline", {
          elementOrSelector: "#my-cal-inline",
          calLink: calendarPath,
          layout: "month_view",
          config: {
            name: clientName,
            email: clientEmail
          }
        });
        w.Cal("ui", {
          "styles": { "branding": { "brandColor": "#2F3631" } },
          "hideEventTypeDetails": false,
          "layout": "month_view"
        });
      }
    }, 100);
  };

  const fetchOnboardingLink = async (queryParam: string, isSessionId = true) => {
    try {
      const url = isSessionId 
        ? `/api/checkout/session?session_id=${queryParam}`
        : `/api/checkout/session?email=${encodeURIComponent(queryParam)}`;
        
      const response = await fetch(url);
      if (!response.ok) throw new Error('Session not found');
      
      const data = await response.json();
      
      // If client has premium tier, mount Cal.com widget inline
      if (data.is_premium) {
        const calContainer = document.getElementById('calContainer');
        if (calContainer) {
          calContainer.style.display = 'block';
          loadCalWidget(calLink, data.name || 'Friend', data.email);
        }
      }

      if (data.deep_link) {
        if (onboardingContainer) {
          onboardingContainer.innerHTML = `
            <p class="status-text" style="color: var(--sage-mid); font-weight: 600;">✨ Onboarding Link Generated!</p>
            <a class="btn-launch" href="${data.deep_link}" target="_blank" rel="noopener">
              🤖 Launch Telegram Onboarding Bot
            </a>
            <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px;">
              Click above to launch your companion. Link expires in 24 hours.
            </p>
          `;
        }
        if (fallback) fallback.style.display = 'none';
      } else {
        // Report purchase successful
        if (onboardingContainer) {
          onboardingContainer.innerHTML = `
            <p class="status-text" style="color: var(--sage-mid); font-weight: 600;">✨ Custom PDF Blueprint Purchased!</p>
            <p style="font-size: 0.92rem; color: var(--text-secondary); text-align: center; line-height: 1.6;">
              Your customized Human Design report has been computed and sent to <strong>${data.email}</strong>. Please check your inbox (and spam folder) in a few minutes.
            </p>
          `;
        }
        if (fallback) fallback.style.display = 'none';
      }
    } catch (err) {
      if (onboardingContainer) {
        onboardingContainer.innerHTML = `
          <p class="status-text" style="color: #cc3333;">⚠️ Verification Pending</p>
          <p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center;">
            We couldn't automatically verify your payment session yet. Your bank may still be finalizing.
          </p>
        `;
      }
      if (fallback) fallback.style.display = 'block';
    }
  };

  if (sessionId) {
    fetchOnboardingLink(sessionId, true);
  } else {
    if (onboardingContainer) onboardingContainer.style.display = 'none';
    if (fallback) fallback.style.display = 'block';
  }

  if (emailForm) {
    emailForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (document.getElementById('emailInput') as HTMLInputElement).value.trim();
      if (email) {
        fetchOnboardingLink(email, false);
      }
    });
  }
</script>
